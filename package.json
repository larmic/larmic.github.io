{
  "name": "larmic-de",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "verify:html": "html-validate \"dist/**/*.html\"",
    "verify:links": "linkinator dist --recurse --check-fragments --skip \"^https?://(?!localhost|127\\\\.0\\\\.0\\\\.1)\"",
    "verify:bundles": "node scripts/verify-bundles.ts",
    "verify": "npm run verify:html && npm run verify:links && npm run verify:bundles && npm run verify:dist",
    "gates": "npm run format:check && npm run lint && npm run arch && npm run check && npm test && npm run build && npm run verify && npm run test:e2e",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:e2e": "playwright test",
    "verify:dist": "node scripts/verify-dist.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "astro": "^7.4.4",
    "sharp": "^0.35.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "html-validate": "^11.18.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
