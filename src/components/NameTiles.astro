---
// „Lars Michaelis“ aus Buchstabenblöcken: LAR und MIC in Gold, daraus entsteht „larmic“.
// Kein <h1>: Der Kopf ist auf allen Seiten gleich, jede Seite hat ihre eigene Hauptüberschrift im Inhalt.
// Die Buchstaben kommen per CSS aus data-ch: Im Text der Seite (Suchmaschinen, Kopieren) steht nur „Lars Michaelis“.
const words = [
  { text: 'LARS', gold: 3 },
  { text: 'MICHAELIS', gold: 3 },
];
let delay = 0;
const rows = words.map((w) =>
  [...w.text].map((ch, k) => ({ ch, gold: k < w.gold, d: (0.04 + delay++ * 0.035).toFixed(2) })),
);
---

<p class="name">
  <span class="sr-only">Lars Michaelis</span>
  {rows.map((row) => (
    <span class="nrow" aria-hidden="true">
      {row.map((t) => (
        <span class="ltw" style={`animation-delay: ${t.d}s`}>
          <span class={t.gold ? 'lt hi' : 'lt'} data-ch={t.ch} />
        </span>
      ))}
    </span>
  ))}
</p>
