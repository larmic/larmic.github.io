---
// Kopf der Seiten ohne Insel (Impressum): Himmel, Logo, Zurück-Button und Titel.
import SiteHeader from './SiteHeader.astro';
import Clouds from './Clouds.astro';

interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<section class="sky subhero">
  <Clouds />
  <SiteHeader />
  <div class="subhero-row">
    <div class="subhero-text">
      <a class="pxbtn small back" href="/">
        <svg width="16" height="16" viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true">
          <path d="M2 3h1v2h-1z M3 2h1v4h-1z M4 1h1v6h-1z" fill="currentColor"></path>
        </svg>
        Zurück zur Insel
      </a>
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
  </div>
</section>
