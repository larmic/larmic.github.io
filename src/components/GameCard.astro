---
// Karte eines Spiels in der Übersicht /spiele/, aufgebaut wie die Karten der Workshops
import type { CollectionEntry } from 'astro:content';
import VoxelIcon from './VoxelIcon.astro';
interface Props {
  entry: CollectionEntry<'games'>;
}
const { entry } = Astro.props;
const d = entry.data;
---

<article class="pxsm wcard th-spiel">
  <div class="cardhead">
    <VoxelIcon block="pilz" />
    <h2>{d.short}</h2>
  </div>
  <p>{d.teaser}</p>
  <p class="wfacts">{d.age} · zu zweit</p>
  <div class="wbtn">
    <a class="pxbtn small" href={`/spiele/${entry.id}/`}>
      Details zum Spiel<span class="sr-only">: {d.short}</span>
    </a>
  </div>
</article>
