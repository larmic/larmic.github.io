---
// Weiterleitung für alte Listen-Adressen: `<base>#<prefix><id>` führt auf die Detailseite `<base><id>/`, sonst auf `to`.
interface Props {
  to: string;
  prefix: string;
  base: string;
}
const { to, prefix, base } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <title>Weiterleitung – larmic.de</title>
    <meta name="robots" content="noindex" />
    <script is:inline define:vars={{ to, prefix, base }}>
      const h = location.hash.slice(1);
      const id = h.startsWith(prefix) ? h.slice(prefix.length) : '';
      location.replace(/^[\w-]+$/.test(id) ? `${base}${id}/` : to);
    </script>
    <meta http-equiv="refresh" content={`0;url=${to}`} />
  </head>
  <body>
    <a href={to}>Weiter zu larmic.de</a>
  </body>
</html>
