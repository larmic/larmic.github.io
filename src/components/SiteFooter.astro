---
import { SOCIALS } from '../data/site';
import MailLink from './MailLink.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="inner">
    <p class="pxf" style="font-size: 24px">larmic.de</p>
    <nav aria-label="Profile">
      {SOCIALS.map((s) => <a href={s.href}>{s.name}</a>)}
    </nav>
    <p><MailLink label="Kontakt" /><a href="/impressum/" style="margin-left: 16px">Impressum</a><a href="/datenschutz/" style="margin-left: 16px">Datenschutz</a><span style="margin-left: 16px">© {year} larmic.de</span></p>
  </div>
</footer>
