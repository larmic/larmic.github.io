---
// Wer Workshops und Beratung anbietet: Lars als Mitarbeiter, Vertragspartner ist die neusta GmbH (§ 6 DDG: Anbieter erkennbar)
import { SITE } from '../data/site';
import MailLink from './MailLink.astro';
interface Props {
  subject?: string; // Betreff der Mail, auf Workshop-Seiten mit dem Workshop
}
const { subject = 'Anfrage Workshop oder Beratung' } = Astro.props;
---

<p class="provider" id="anfrage">
  Workshops und Beratung biete ich als Mitarbeiter von <a href="https://www.team-neusta.de/de">team neusta</a> an.
  Vertragspartner ist die neusta GmbH. Anfragen gern an{' '}
  <MailLink address={SITE.workshopMail} subject={subject} fallback="#anfrage" />.
</p>
