---
// YouTube erst nach Klick laden: vorher keine Verbindung zu YouTube. Darunter der Hinweis für eine informierte
// Einwilligung und ein normaler Link zu YouTube (funktioniert auch ohne JavaScript).
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<div class="yt" data-yt={id} data-title={title}>
  <button type="button">
    <svg width="64" height="64" viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true">
      <path d="M3 1h1v6h-1z M4 2h1v4h-1z M5 3h1v2h-1z" fill="#ee4b3e"></path>
    </svg>
    Video abspielen
    <small>Lädt das Video von YouTube (Google)</small>
  </button>
</div>
<p class="yt-note">
  Beim Abspielen werden Daten an Google übertragen, auch in die USA – mehr dazu in der{' '}
  <a href="/datenschutz/">Datenschutzerklärung</a>. Lieber ohne Einbettung? Dann{' '}
  <a href={`https://www.youtube.com/watch?v=${id}`}>direkt auf YouTube ansehen</a>.
</p>
<script>
  // Ein Handler für alle Videos, auch nach einem Seitenwechsel ohne Neuladen
  document.addEventListener('click', (e) => {
    const el = (e.target as Element).closest<HTMLElement>('.yt');
    if (!el || !(e.target as Element).closest('.yt button')) return;
    const frame = document.createElement('iframe');
    frame.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1`;
    frame.title = el.dataset.title || 'YouTube-Video';
    frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    frame.allowFullscreen = true;
    el.replaceChildren(frame);
  });
</script>
