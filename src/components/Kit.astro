---
import type { Kit } from '../data/site';
import { MATERIALS } from '../data/materials';
interface Props {
  kit: Kit;
}
const { kit } = Astro.props;
const { block, icon } = MATERIALS[kit.id];
---

<section class={`kit ${kit.id} pxsm`} aria-labelledby={`kit-${kit.id}`}>
  <div class="kithead">
    <svg width="34" height="36" viewBox="0 0 80 84.8" aria-hidden="true" style={`color: ${icon}`}>
      <use href={`#v-${block}`}></use>
    </svg>
    <h3 id={`kit-${kit.id}`}>{kit.title}</h3>
  </div>
  <p class="kitsub">{kit.sub}</p>
  <ul class="items">
    {kit.items.map((it) => (
      <li class="item">
        <svg viewBox="0 0 80 84.8" aria-hidden="true" style={`color: ${it.color}`}>
          <use href={`#v-${block}`}></use>
        </svg>
        <span class="lbl">{it.label}</span>
      </li>
    ))}
  </ul>
</section>
