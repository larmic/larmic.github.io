---
import { getCollection, render } from 'astro:content';
import IslandPage from '../../layouts/IslandPage.astro';
import VoxelIcon from '../../components/VoxelIcon.astro';
import { MATERIALS } from '../../data/site';

export async function getStaticPaths() {
  const workshops = await getCollection('workshops', ({ data }) => !data.draft);
  return workshops.map((w) => ({ params: { id: w.id }, props: { w } }));
}
const { w } = Astro.props;
const { Content } = await render(w);
const m = MATERIALS[w.data.material];
---
<IslandPage title={w.data.title} description={w.data.teaser} rest={`workshops/${w.id}`}>
  <div class="panel-head">
    <VoxelIcon block={m.block} color={m.icon || undefined} size={64} />
    <div><h1>{w.data.title}</h1><p>{w.data.teaser}</p></div>
  </div>
  <div class="prose">
    <Content />
    {w.data.link && <p><a class="pxbtn small" href={w.data.link}>{w.data.linkLabel ?? 'Mehr erfahren'}</a></p>}
  </div>
  <a class="backlink" href="/workshops/">Alle Workshops</a>
</IslandPage>
