---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubHero from '../../components/SubHero.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { BUBBLES } from '../../data/site';

export async function getStaticPaths() {
  const workshops = await getCollection('workshops', ({ data }) => !data.draft);
  return workshops.map((w) => ({ params: { id: w.id }, props: { w } }));
}
const { w } = Astro.props;
const { Content } = await render(w);
const back = { href: '/#workshops', label: 'Zurück zur Insel' };
---
<BaseLayout title={w.data.title} description={w.data.teaser}>
  <SubHero title={w.data.title} lead={w.data.teaser} back={back} perch={{ block: 'board', bubble: BUBBLES.workshops }} />
  <div class="grass-edge" aria-hidden="true"></div>
  <main class="ground">
    <div class="doc">
      <article class={`entry pxbox th-${w.data.material}`}>
        <div class="prose"><Content /></div>
        {w.data.link && <p><a class="pxbtn small" href={w.data.link}>{w.data.linkLabel ?? 'Mehr erfahren'}</a></p>}
        <a class="backlink" href={back.href}>{back.label}</a>
      </article>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
