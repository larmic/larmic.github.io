---
import { getCollection } from 'astro:content';
import IslandPage from '../../layouts/IslandPage.astro';
import VoxelIcon from '../../components/VoxelIcon.astro';
import GameCard from '../../components/GameCard.astro';

const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
---

<IslandPage
  title="Spiele"
  description="Kinderspiele von Lars Michaelis: ruhig, ohne Werbung und zum gemeinsamen Spielen mit einem Elternteil."
  rest="spiele"
>
  <div class="panel-head">
    <VoxelIcon block="dice" size={64} />
    <div>
      <h1>Spiele</h1>
      <p>Für Kinder, die mit Mama oder Papa zusammen spielen.</p>
    </div>
  </div>
  <div class="cards">
    {games.map((g) => (
      <GameCard entry={g} />
    ))}
  </div>
</IslandPage>
