---
import '../../styles/blog.css';
import IslandPage from '../../layouts/IslandPage.astro';
import VoxelIcon from '../../components/VoxelIcon.astro';
import SeriesBox from '../../components/SeriesBox.astro';
import PostList from '../../components/PostList.astro';
import { loadBlog, restFor } from '../../data/blog';

const { posts, series } = await loadBlog();
// Oben steht die Serie, die noch läuft; ist keine offen, die zuletzt angelegte
const current = series.find((s) => s.status === 'läuft') ?? series.at(-1);
---

<IslandPage
  title="Blog"
  description="Notizen eines Architekten, der nebenbei Vater ist: KI mit Leitplanken, Guards, Testing und ein Spiel für einen Dreijährigen."
  rest={restFor()}
>
  <div class="panel-head">
    <VoxelIcon block="shelf" size={64} />
    <div>
      <h1>Blog</h1>
      <p>Notizen eines Architekten, der nebenbei Vater ist.</p>
    </div>
  </div>
  {current && <SeriesBox series={current} />}
  <h2 class="blog-h2">Alle Posts</h2>
  {posts.length > 0 ? <PostList posts={posts} series={series} /> : <p>Hier steht bald der erste Post.</p>}
</IslandPage>
